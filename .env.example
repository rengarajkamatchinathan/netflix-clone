# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# Optional: database connections per server process (default 10). With Neon, use the pooled (-pooler) host above.
# PG_POOL_MAX=10
# Long random string used to sign login cookies
JWT_SECRET=change-me
# Admin account created by `npm run db:setup` (only if it doesn't exist yet)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=change-me
